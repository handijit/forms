{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // The browser test app imports every entry by its package name; resolve them to the sources so
    // the type check does not depend on a build being there (CI checks types before it builds).
    "paths": {
      "@handijit/forms": ["./lib/index.ts"],
      "@handijit/forms/ui": ["./lib/ui.ts"],
      "@handijit/forms/tr": ["./lib/tr.ts"]
    }
  },
  "include": [
    "lib",
    "__tests__",
    "e2e",
    "vitest.config.mts",
    "vitest.setup.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "build", "e2e/out"]
}
