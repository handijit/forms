{
  // Node's own resolution, both module systems. `skipLibCheck` is off: since @handijit/ui 2.2 its
  // declarations resolve under `nodenext` too (ESM and CommonJS), so every declaration file of
  // the consumer's tree is checked here as in the bundler pass.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "files": ["consumer.ts", "consumer.mts"]
}
