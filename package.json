{
  "name": "@handijit/forms",
  "version": "1.0.0",
  "description": "Zod-based client forms for React: a typed, headless form store with field-level subscriptions, accessible error handling and ready binders for the @handijit/ui field components.",
  "author": "Ahmet ilhan <ahmetilhan.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handijit/forms.git"
  },
  "homepage": "https://github.com/handijit/forms#readme",
  "bugs": {
    "url": "https://github.com/handijit/forms/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.cjs"
      },
      "default": "./build/index.mjs"
    },
    "./ui": {
      "import": {
        "types": "./build/ui.d.mts",
        "default": "./build/ui.mjs"
      },
      "require": {
        "types": "./build/ui.d.ts",
        "default": "./build/ui.cjs"
      },
      "default": "./build/ui.mjs"
    },
    "./tr": {
      "import": {
        "types": "./build/tr.d.mts",
        "default": "./build/tr.mjs"
      },
      "require": {
        "types": "./build/tr.d.ts",
        "default": "./build/tr.cjs"
      },
      "default": "./build/tr.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "ui": [
        "./build/ui.d.ts"
      ],
      "tr": [
        "./build/tr.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "build",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "react18"
  ],
  "scripts": {
    "build": "sh ./scripts/prod-build.sh",
    "dev": "sh ./scripts/dev-build.sh",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "size": "node ./scripts/report-size.mjs",
    "lint:package": "publint && attw --pack .",
    "test:smoke": "sh ./scripts/smoke-test.sh",
    "test:browser": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size && npm run lint:package && npm run test:smoke",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "react",
    "forms",
    "form",
    "zod",
    "validation",
    "typescript",
    "accessibility",
    "a11y",
    "headless",
    "field-array",
    "electron",
    "handijit"
  ],
  "private": false,
  "peerDependencies": {
    "@handijit/tr": "^1.0.0",
    "@handijit/ui": "^2.0.0",
    "react": ">=18",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@handijit/tr": {
      "optional": true
    },
    "@handijit/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@handijit/design": "^1.0.0",
    "@handijit/tr": "^1.0.0",
    "@handijit/ui": "^2.0.0",
    "@handijit/utils": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.2.0",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.2.0",
    "rollup": "^4.68.2",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.9.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
